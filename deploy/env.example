# Copy to .env next to docker-compose.yml. Every value is a placeholder.
# Folder with your imported game packs (read only, mounted into the game server).
SIEGE_GAMEDATA=../gamedata
# LAN profile: port of the web page, and the folder the web build/data is published to (siege-update.sh SITE_DIR).
SIEGE_HTTP_PORT=8080
SIEGE_SITE_DIR=/srv/siege/site
# Public profile: the DNS name Caddy gets a Let's Encrypt certificate for.
SIEGE_DOMAIN=play.example.org
